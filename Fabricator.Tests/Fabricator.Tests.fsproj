<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="FakeResource.fs" />
        <Compile Include="Console\CommandsTests.fs" />
        <Compile Include="Console\EntryPointTests.fs" />
        <Compile Include="Console\ExecutionUiTests.fs" />
        <Compile Include="Console\LoweringTests.fs" />
        <Compile Include="Console\OrderedLogTests.fs" />
        <Compile Include="Console\ReportTests.fs" />
        <Compile Include="Console\TaskExecutorTests.fs" />
        <Compile Include="Core\ResourceTests.fs" />
        <Compile Include="Resources\DiffsTests.fs" />
        <Compile Include="Resources\DownloadsTests.fs" />
        <Compile Include="Resources\FileTests.fs" />
        <Compile Include="Resources\HostsFileTests.fs" />
        <Compile Include="Resources\WindowsCertificatesTests.fs" />
        <Compile Include="Resources\WindowsServicesTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="TaskBuilder.fs" Version="2.1.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Fabricator.Console\Fabricator.Console.fsproj" />
      <ProjectReference Include="..\Fabricator.Core\Fabricator.Core.fsproj" />
      <ProjectReference Include="..\Fabricator.Resources\Fabricator.Resources.fsproj" />
    </ItemGroup>

</Project>
