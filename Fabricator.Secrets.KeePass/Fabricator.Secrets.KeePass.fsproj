<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>
            KeePass secret storage for Fabricator, an infrastructure automation framework.
        </Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="KeePassSecretStore.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Fabricator.Core\Fabricator.Core.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Pidamg.KeePass.Kdbx" Version="0.1.1" />
      <PackageReference Include="TruePath" Version="2.0.0" />
    </ItemGroup>

</Project>
